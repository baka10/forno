# Copy to .env for local (non-docker) runs. Inside `make up`, docker-compose.yml
# sets these directly — this file documents the contract. See docs/configuration.md
# "Runtime configuration". One Pydantic Settings object, validated at boot; the
# process refuses to start on anything invalid or missing.

# --- Required ----------------------------------------------------------------
FORNO_DATABASE_URL=postgresql+asyncpg://forno:forno@localhost:5432/forno
FORNO_KAFKA_BOOTSTRAP=localhost:19092

# --- Process role --------------------------------------------------------------
# serve | relay | project (kitchen|stats selected via CLI arg, see forno/__main__.py)
FORNO_ROLE=serve

# --- Time ----------------------------------------------------------------------
# Domain seconds per wall-clock second (docs/adr/0009-scaled-domain-time.md).
# 1 for a real kitchen. `make demo`/`make live` override it from the scenario
# file; the simulator refuses to run against an API on a different scale.
FORNO_TIME_SCALE=1

# --- Domain seam ---------------------------------------------------------------
FORNO_PROMISE_ESTIMATOR=naive
FORNO_PROMISE_GRACE_SECONDS=120

# --- Outbox relay ---------------------------------------------------------------
FORNO_OUTBOX_POLL_MS=200
FORNO_OUTBOX_BATCH=100

# --- Consumers -------------------------------------------------------------------
FORNO_CONSUMER_MAX_RETRIES=5

# --- Edge ---------------------------------------------------------------------
FORNO_SSE_QUEUE_SIZE=256

# --- Metrics ---------------------------------------------------------------------
# /metrics port for relay/project roles, which have no FastAPI process of
# their own; `serve` exposes /metrics on the main HTTP port (8000) instead.
FORNO_METRICS_PORT=9100

# --- Observability ---------------------------------------------------------------
FORNO_LOG_LEVEL=INFO
FORNO_TRACING_ENABLED=false
