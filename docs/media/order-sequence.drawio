        <mxCell id="m0" value="POST /orders + Idempotency-Key + X-Request-ID" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0989;entryX=0;entryY=0.0;" edge="1" parent="1" source="c" target="act1">
